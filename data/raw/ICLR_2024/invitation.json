      ],
      "invitees": [
        "~"
      ],
      "edit": {
        "signatures": {
          "param": {
            "items": [
              {
                "prefix": "~.*",
                "optional": true
              },
              {
                "value": "ICLR.cc/2024/Conference/Program_Chairs",
                "optional": true
              }
            ]
          }
        },
        "readers": [
          "ICLR.cc/2024/Conference",
          "${2/note/content/authorids/value}"
        ],
        "writers": [
          "ICLR.cc/2024/Conference",
          "${2/note/content/authorids/value}"
        ],
        "ddate": {
          "param": {
            "range": [
              0,
              9999999999999
            ],
            "optional": true,
            "deletable": true
          }
        },
        "note": {
          "content": {
            "title": {
              "order": 1,
              "description": "Title of paper. Add TeX formulas using the following formats: $In-line Formula$ or $$Block Formula$$.",
              "value": {
                "param": {
                  "type": "string",
                  "regex": "^.{1,250}$"
                }
              }
            },
            "supplementary_material": {
              "value": {
                "param": {
                  "type": "file",
                  "extensions": [
                    "zip",
                    "pdf"
                  ],
                  "maxSize": 100,
                  "optional": true
                }
              },
              "description": "All supplementary material must be self-contained and zipped into a single file. Note that supplementary material will be visible to reviewers and the public throughout and after the review period, and ensure all material is anonymized. The maximum file size is 100MB.",
              "order": 1
            },
            "authors": {
              "order": 2,
              "value": {
                "param": {
                  "type": "string[]",
                  "regex": "[^;,\\n]+(,[^,\\n]+)*",
                  "hidden": true
                }
              }
            },
            "primary_area": {
              "value": {
                "param": {
                  "type": "string",
                  "enum": [
                    "unsupervised, self-supervised, semi-supervised, and supervised representation learning",
                    "transfer learning, meta learning, and lifelong learning",
                    "reinforcement learning",
                    "representation learning for computer vision, audio, language, and other modalities",
                    "metric learning, kernel learning, and sparse coding",
                    "probabilistic methods (Bayesian methods, variational inference, sampling, UQ, etc.)",
                    "generative models",
                    "causal reasoning",
                    "optimization",
                    "learning theory",
                    "learning on graphs and other geometries & topologies",
                    "societal considerations including fairness, safety, privacy",
                    "visualization or interpretation of learned representations",
                    "datasets and benchmarks",
                    "infrastructure, software libraries, hardware, etc.",
                    "neurosymbolic & hybrid AI systems (physics-informed, logic & formal reasoning, etc.)",
                    "applications to robotics, autonomy, planning",
                    "applications to neuroscience & cognitive science",
                    "applications to physical sciences (physics, chemistry, biology, etc.)",
                    "general machine learning (i.e., none of the above)"
                  ],
                  "input": "select"
                }
              },
              "description": "Please choose the closest area that your submission falls into.",
              "order": 2
            },
            "authorids": {
              "order": 3,
              "description": "Search author profile by first, middle and last name or email address. If the profile is not found, you can add the author by completing first, middle, and last names as well as author email address.",
              "value": {
                "param": {
                  "type": "group[]",
                  "regex": "^~\\S+$|^[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
                  "mismatchError": "must be a valid email or profile ID"
                }
              }
            },
            "code_of_ethics": {
              "value": {
                "param": {
                  "type": "string",
                  "enum": [
                    "I acknowledge that I and all co-authors of this work have read and commit to adhering to the ICLR Code of Ethics."
                  ],
                  "input": "checkbox"
                }
              },
              "description": "See the ICLR Code of Ethics: https://iclr.cc/public/CodeOfEthics.",
              "order": 3
            },
            "keywords": {
              "description": "Comma separated list of keywords.",
              "order": 4,
              "value": {
                "param": {
                  "type": "string[]",
                  "regex": ".+"
                }
              }
            },
            "submission_guidelines": {
              "value": {
                "param": {
                  "type": "string",
                  "enum": [
                    "I certify that this submission complies with the submission instructions as described on https://iclr.cc/Conferences/2024/AuthorGuide."
                  ],
                  "input": "checkbox"
                }
              },
              "order": 4
            },
            "TLDR": {
              "order": 5,
              "description": "\"Too Long; Didn't Read\": a short sentence describing your paper",
              "value": {
                "param": {
                  "fieldName": "TL;DR",
                  "type": "string",
                  "maxLength": 250,
                  "optional": true,
                  "deletable": true
                }
              }
            },
            "resubmission": {
              "value": {
                "param": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No"
                  ],
                  "input": "radio"
                }
              },
              "description": "In the past 12 months, have you submitted (a version of) this work to another peer-reviewed archival venue? This question is for statistical purposes only.",
              "order": 5
            },
            "abstract": {
              "order": 6,
              "description": "Abstract of paper. Add TeX formulas using the following formats: $In-line Formula$ or $$Block Formula$$.",
              "value": {
                "param": {
                  "type": "string",
                  "maxLength": 5000,
                  "markdown": true,
                  "input": "textarea"
                }
              }
            },
            "student_author": {
              "value": {
                "param": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No"
                  ],
                  "input": "radio"
                }
              },
              "description": "Is the primary author a student at the time of submission? This question is for statistical purposes only.",
              "order": 6
            },
            "pdf": {
              "order": 7,
              "description": "Upload a PDF file that ends with .pdf.",
              "value": {
                "param": {
                  "type": "file",
                  "maxSize": 50,
                  "extensions": [
                    "pdf"
                  ],
                  "optional": true
                }
              }
            },
            "anonymous_url": {
              "value": {
                "param": {
                  "type": "string",
                  "enum": [
                    "I certify that there is no URL (e.g., github page) that could be used to find authors' identity."
                  ],
                  "input": "checkbox"
                }
              },
              "order": 7
            },
            "no_acknowledgement_section": {
              "value": {
                "param": {
                  "type": "string",
                  "enum": [
                    "I certify that there is no acknowledgement section in this submission for double blind review."
                  ],
                  "input": "checkbox"
                }
              },
              "order": 8
            },
            "large_language_models": {
              "value": {
                "param": {
                  "type": "string[]",
                  "enum": [
                    "No, not at all.",
                    "Yes, at the sentence level (e.g., fixing grammar, re-wording sentences)",
                    "Yes, at the paragraph level (e.g., re-organizing sentences in a paragraph, summarizing related work)",
                    "Yes, for retrieval and discovery (e.g., finding related work)",
                    "Yes, for catchy paper title suggestions."
                  ],
                  "input": "checkbox"
                }
              },
              "description": "Did you use Large Language Models (LLMs) in paper writing? (click all that apply) This question is for statistical purposes only.",
              "order": 9
            },
            "other_comments_on_LLMs": {
