        {
          "note_id": "AZCEgKPLdF",
          "fields": {
            "display_title": "We have shortened the caption of Figure 1 for clarity, revised author references to use \\citet{}, and expanded Table 3 to include key structural properties of eight datasets. We also added IMDB and DBLP datasets to evaluate scalability (Table 1), and clarified that while larger datasets like ogbn-arxiv were not used due to resource constraints, future work will address this.",
            "replying_to": "Replying to Official Review of Submission3997 by Reviewer 49KC"
          }
        },
        {
          "note_id": "b0t4KorybW",
          "fields": {
            "display_title": "Official Review of Submission3997 by Reviewer ErwD",
            "replying_to": "Replying to DistillHGNN: A Knowledge Distillation Approach for High-Speed Hypergraph Neural Networks"
          }
        },
        {
          "note_id": "mQzGLILvAd",
          "fields": {
            "display_title": "Our approach extends LightHGNN with a dual knowledge transfer mechanism for better high-order information preservation, utilizing both structural and predictive knowledge transfer via contrastive learning and soft labels. The simplified architecture of TinyGCN enables efficient processing of new nodes without graph reconstruction.",
            "replying_to": "Replying to Official Review of Submission3997 by Reviewer ErwD"
          }
        },
