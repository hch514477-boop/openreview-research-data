        {
          "note_id": "IBFdRqFRuH",
          "fields": {
            "display_title": "The paper tackles the problem of image segmentation leveraging neural architecture search. Inspired by dendritic branching, the proposed method, termed Bractivate, identifies the most salient block in sampled candidate and mutates the architecture by randomly generating connection from other blocks. The results show the improvement of the segmentation on several datasets.",
            "replying_to": "Replying to Bractivate: Dendritic Branching in Medical Image Segmentation Neural Architecture Search"
          }
        },
        {
          "note_id": "vG4RWv-7FLt",
          "fields": {
            "display_title": "This paper proposed a methods inspired from the brain to add skip connections on the UNet, which can improve the network’s performance. At each iteration, the model adds a new skip-connect branch to the most active block. Experiment results on some datasets are shown.",
            "replying_to": "Replying to Bractivate: Dendritic Branching in Medical Image Segmentation Neural Architecture Search"
          }
        },
