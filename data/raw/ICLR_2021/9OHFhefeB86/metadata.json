        {
          "note_id": "2a9u2cCyvo",
          "fields": {
            "display_title": "This paper proposed L3Net which is a new graph convolution with low-rank learnable local filters. L3Net is applicable for both spatial and spectral graph convolution. Experiments are conducted on mesh data, facial recognition and action recognition. Its robustness to graph noise is also tested.",
            "replying_to": "Replying to Graph Convolution with Low-rank Learnable Local Filters"
          }
        },
